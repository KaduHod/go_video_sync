<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Sync {{ .room.Name }}</title>
        <link href="/public/css/main.css" rel="stylesheet">
    </head>
    <body class="bg-gray-900 text-white min-h-screen flex flex-col items-center justify-center">
        <header class="fixed top-0 left-0 w-full bg-gray-800 shadow-md z-50">
            <div class="max-w-screen-xl mx-auto flex justify-between items-center px-6 py-4">
                <div class="flex items-center">
                    <img src="/public/images/logo-simples.svg" alt="Logo" class="w-12 h-12 mr-3">
                    <span class="text-xl font-bold text-white">Sync Video</span>
                    <span class="ml-2 px-2 py-1 bg-purple-600 text-white text-sm font-semibold rounded-full shadow-sm">BETA</span>
                </div>
                <nav class="hidden md:flex space-x-6">
                    <a href="#contato" class="text-gray-300 hover:text-white transition">Contato</a>
                </nav>
                <button class="md:hidden text-gray-300 hover:text-white focus:outline-none">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </header>

        <main class="flex w-full flex-1 mt-4 flex-col items-center justify-center space-y-6">
            <div class="w-full max-w-md p-4 flex justify-start">
                <h1 class="text-4xl font-bold text-center text-purple-400 mb-4">
                    🎬 Sala: <span class="text-purple-500">{{ .room.Name }}</span>
                </h1>
            </div>

            <div id="Player" class="flex flex-col items-center">
                <!-- Container que une o player e os controles -->
                <div class="player-container bg-gray-800 p-4 rounded-lg flex flex-col items-center space-y-4">
                    <!-- Botões adicionais abaixo da estrutura do player -->
                    {{ if eq .user_type "Admin" }}
                    <div class="w-full flex justify-start space-x-4">
                        <button id="copiar-link" class="bg-purple-600 px-2 py-2 text-white rounded-md text-sm shadow-md hover:bg-purple-700 focus:outline-none focus:ring-4 focus:ring-purple-500 transition-all">
                            Copiar Link de Convidado
                        </button>
                        <button id="close-room" class="bg-red-600 text-white mx-2 px-2 py-2 rounded-md text-sm shadow-md hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-500 transition-all">
                            Terminar sessão
                        </button>
                    </div>

                    <div class="w-full flex justify-start space-x-4">
                        <input type="text" id="videoUrl" placeholder="Insira a URL do vídeo" class="flex-1 p-2 bg-gray-700 text-white rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 transition" />
                        <button id="loadVideoButton" class="flex-5 bg-purple-600 text-white p-2 rounded-md hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purle-500 transition">Carregar Vídeo</button>
                    </div>
                    {{ end }}

                    <div id="ytplayer"></div>
                    <div class="w-full flex justify-start controls space-x-4">
                    <div class="w-full flex justify-start controls space-x-4">
                        <button id="pausePlayButton" class="relative w-12 h-10 p-3 flex items-center justify-center bg-purple-600 text-whit rounded-md hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purle-500 transition">
                            <img src="/public/images/play.svg" id="play" class="hidden"></img>
                            <img src="/public/images/pause.svg" id="pause" class=""></img>
                        </button>
                        <div id="counter-video" class="text-center flex items-center">

                        </div>
                    </div>
                        <div id="counter-video" class="text-center flex items-center">

                        </div>
                    </div>
                </div>
            </div>
        </main>
        <input name="csrf" id="csrf" type="hidden" value="{{ .csrf }}">

        <footer class="bg-gray-800 text-gray-300 w-full py-4 flex flex-col justify-center items-center mt-auto">
            <div id="contato" class="text-center">
                <h2 class="text-lg font-semibold mb-1">Entre em contato</h2>
                <div class="flex space-x-4 justify-around">
                    <a href="https://github.com/KaduHod" target="_blank" class="hover:text-white">
                        <img
                        src="/public/images/github.svg"
                        alt="GitHub"
                        class="w-6 h-6 inline"
                        />
                    </a>
                    <a href="https://www.linkedin.com/in/carlosjrribas98/" target="_blank" class="hover:text-white">
                        <img
                        src="/public/images/linkedin.svg"
                        alt="LinkedIn"
                        class="w-6 h-6 inline"
                        />
                    </a>
                    <a href="mailto:carlosjr.ribas@gmail.com" class="hover:text-white">
                        <img
                        src="https://cdn.simpleicons.org/gmail/ffffff"
                        alt="Gmail"
                        class="w-6 h-6 inline"
                        />
                    </a>
                </div>
            </div>
        </footer>

        <script>
            const copiarLink = document.getElementById("copiar-link")
            if(copiarLink) {
                copiarLink.addEventListener("click", () => {
                    navigator.clipboard.writeText("{{ .room.GuestLink }}").then(() => {
                        const oldTitle = copiarLink.innerText;
                        copiarLink.innerText = "Copiado!";
                        setTimeout(() => {
                            copiarLink.innerText = oldTitle;
                        }, 5000)
                    }).catch(err => {
                        console.error("Erro ao copiar:", err);
                    });
                });
            }
            window.room_name = "{{ .room.Name }}";
            window.user_name = "{{ .user.Name }}";
            window.user_type = "{{ .user_type }}";
            function User(userType) {
                const type = userType
                const player = "waiting"
                const sse = "waiting"
                const room = window.room_name
                const name = window.user_name
                return {type, player, sse, room, name}
            }
            window.user = new User(window.user_type.toLowerCase() == "admin" ? "admin" : "guest")
            window.friend = new User(window.user_type.toLowerCase() == "admin" ? "guest" : "admin")
            function PlayerManager() {
                const videoUrl = "";
                const state = "waiting";
                const time = 0;
                const user = {};
                const getUser = function () {
                    this.user = window.user
                    return this.user
                }
                return {videoUrl, state, time, user, getUser}
            }
            window.player_manager = new PlayerManager()
        </script>
        <script src="/public/scripts/header.js"></script>
        <script src="/public/scripts/youtube.js"></script>
        <script src="/public/scripts/sse.js"></script>
    </body>
</html>

