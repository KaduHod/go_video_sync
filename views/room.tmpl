<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Sync {{ .room.Name }}</title>
        <link href="/public/css/main.css" rel="stylesheet">
    </head>
    <body>
        {{ if eq .user_type "Admin" }}
        <h1>Bem-vindo, Admin da sala: {{ .room.Name }}</h1>
        <a id="guestLink" href="{{ .room.GuestLink }}">Guest link</a>
        <button onclick="copyToClipboard()">Copiar Guest Link</button>
        {{ else }}
        <h1>Room: {{ .room.Name }}</h1>
        {{ end }}
        <input name="csrf" id="csrf" type="hidden" value="{{ .csrf }}">
        <button id="pauseButton">Pausar</button>
        <button id="resumeButton">Continuar</button>
        {{ if eq .user_type "Admin" }}
        <button id="close-room">Parar</button>
        {{end}}
    </body>
    <script>
        window.room_name = "{{ .room.Name }}";
        window.user_name = "{{ .user.Name }}";
        function copyToClipboard() {
            const link = document.getElementById("guestLink").href;
            navigator.clipboard.writeText(link).then(() => {
            }).catch(err => {
                console.error("Erro ao copiar:", err);
            });
        }
    </script>
    <script src="/public/scripts/sse.js"></script>
</html>
